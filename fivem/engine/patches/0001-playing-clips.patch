+    /// The clips this tick's pose is blended from: name, time in the clip (seconds), share of the pose (0..1)
+    /// and whether it is played mirrored. For a host that cannot set bones and plays the clips itself.
+    pub fn clips(&self) -> Vec<(String, f32, f32, bool)> {
+        use skate_core::animation::playback_tree::PoseCommand;
+        let mut stack: Vec<Vec<(String, f32, f32, bool)>> = Vec::new();
+        for command in &self.skater.animation.last_commands {
+            match command {
+                PoseCommand::Clip { name, time, .. } => stack.push(vec![(name.clone(), *time, 1.0, false)]),
+                PoseCommand::Pose { name } => stack.push(vec![(name.clone(), 0.0, 1.0, false)]),
+                // (an added pose changes the one under it; it has no share of its own)
+                PoseCommand::Add { .. } => {
+                    stack.pop();
+                }
+                PoseCommand::Mirror { .. } => {
+                    if let Some(top) = stack.last_mut() {
+                        for clip in top {
+                            clip.3 = !clip.3;
+                        }
+                    }
+                }
+                PoseCommand::WeightedBlend { weights } => {
+                    let start = stack.len().saturating_sub(weights.len());
+                    let parts: Vec<_> = stack.drain(start..).collect();
+                    let mut out = Vec::new();
+                    for (part, weight) in parts.into_iter().zip(weights) {
+                        for mut clip in part {
+                            clip.2 *= *weight;
+                            out.push(clip);
+                        }
+                    }
+                    stack.push(out);
+                }
+                PoseCommand::Blend { weight } | PoseCommand::ChannelBlend { weight, .. } => {
+                    let second = stack.pop().unwrap_or_default();
+                    let mut first = stack.pop().unwrap_or_default();
+                    for clip in &mut first {
+                        clip.2 *= 1.0 - *weight;
+                    }
+                    for mut clip in second {
+                        clip.2 *= *weight;
+                        first.push(clip);
+                    }
+                    stack.push(first);
+                }
+            }
+        }
+        stack.pop().unwrap_or_default()
+    }
